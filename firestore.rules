rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Fonksiyonlar
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Dokümanı oluşturan kişi mi kontrolü (Farklı veri yapılarını destekler)
    function isContentOwner() {
      return isAuthenticated() && (
        (resource.data.keys().contains('authorId') && resource.data.authorId == request.auth.uid) ||
        (resource.data.keys().contains('userId') && resource.data.userId == request.auth.uid) ||
        (resource.data.keys().contains('createdBy') && resource.data.createdBy == request.auth.uid) ||
        (resource.data.keys().contains('author') && resource.data.author.id == request.auth.uid)
      );
    }

    // User Profile Documents
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId); // Başkası senin profilini değiştiremez
      allow delete: if isOwner(userId);
    }

    // Feed Posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isContentOwner(); // Sadece postun sahibi düzenleyebilir/silebilir
    }

    // Communities
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isContentOwner(); // Sadece topluluğu kuran kişi düzenleyebilir/silebilir
    }

    // Platform Settings & Admin Configs
    match /settings/{settingId} {
      allow read: if true;
      allow write: if false; // İstemciden değiştirilemez, sadece Console/Admin SDK yazar
    }
  }
}
