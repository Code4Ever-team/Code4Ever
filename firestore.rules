rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Fonksiyonlar
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Kullanıcı Profilleri
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId); // Sadece kendi profilini güncelleyebilsin
      allow delete: if isOwner(userId);
    }

    // Gönderiler (Posts)
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Güncelleme ve Silme sadece postu oluşturan kişiye ait olmalı
      // (Not: Post dokümanında 'authorId' veya 'userId' alanının tutulduğu varsayılmıştır)
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    // Topluluklar (Communities)
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Sadece topluluğu kuran kişi güncelleyebilsin/silebilsin
      allow update, delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // Platform Ayarları
    match /settings/{settingId} {
      allow read: if true; // Herkes veya giriş yapmış kullanıcılar okusun
      allow write: if false; // İstemci (client) tarafından değiştirilemesin, sadece Admin SDK / Console yazabilsin
    }
  }
}
